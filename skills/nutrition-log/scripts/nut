#!/usr/bin/env python3
"""nut: short front-end for the household nutrition log (hermes side). Wraps nutrition.py.

Always uses the REAL shared DB (~/.hermes/data/nutrition.db): it drops any stale NUTRITION_DB from the env.
Pass --practice to use ~/.hermes/data/nutrition_practice.db instead.

  nut eat <person> "<dish>" food:qty[:unit] [food:qty ...] [--at HH:MM|ISO] [--meal snack] [--packed] [--by priyanka]
        One dish, many ingredients, one command. Ingredients of the same dish never trip the duplicate check.
        e.g.  nut eat tegh "butter roti roll" roti:1 butter:1:tsp --at 15:30 --meal snack
  nut today [person|all]   summary for one person, or every person with entries today (default: all)
  nut find <text>          look up food keys (no SQL)
  nut fix <id> ...         = nutrition.py edit <id> ...
  nut rm <id>              delete an entry (person inferred)
  nut <anything else>      passed straight to nutrition.py (log, food add, eaten, gaps, week, ...)

Defaults: --reported-by sumeet, --logged-by hermes, --at now (local).
"""
import datetime as dt, os, re, subprocess, sys

HERE = os.path.dirname(os.path.realpath(__file__))
NUT = [sys.executable, os.path.join(HERE, "nutrition.py")]
args = sys.argv[1:]
env = dict(os.environ)
env.pop("NUTRITION_DB", None)
if "--practice" in args:
    args.remove("--practice")
    env["NUTRITION_DB"] = os.path.expanduser("~/.hermes/data/nutrition_practice.db")


def run(a, check=False):
    r = subprocess.run(NUT + a, env=env, capture_output=True, text=True)
    out = (r.stdout + r.stderr).strip()
    return r.returncode, out


def opt(name, default=None, flag=False):
    if name in args:
        i = args.index(name)
        if flag:
            args.pop(i); return True
        v = args[i + 1]; del args[i:i + 2]; return v
    return default


def when(s):
    if not s:
        return dt.datetime.now().strftime("%Y-%m-%dT%H:%M")
    if re.fullmatch(r"\d{1,2}:\d{2}", s):
        return dt.date.today().isoformat() + "T" + s.zfill(5)
    return s


if not args or args[0] in ("-h", "--help", "help"):
    print(__doc__); sys.exit(0)

cmd = args.pop(0)
if cmd == "eat":
    at = when(opt("--at")); meal = opt("--meal"); by = opt("--by", "sumeet"); packed = opt("--packed", flag=True)
    person, dish, items = args[0], args[1], args[2:]
    if not items:
        sys.exit("need at least one food:qty")
    rc_all = 0
    for k, it in enumerate(items):
        parts = it.split(":")
        food, qty, unit = parts[0], parts[1] if len(parts) > 1 else "1", (parts[2] if len(parts) > 2 else None)
        a = ["log", food, qty] + ([unit] if unit else []) + ["--person", person, "--at", at, "--desc", dish,
             "--reported-by", by, "--logged-by", "hermes"]
        if meal: a += ["--meal", meal]
        if packed: a += ["--packed"]
        if k > 0:
            a += ["--force"]  # later ingredients of the SAME dish are not duplicates of the first
        rc, out = run(a)
        print(out.splitlines()[-1] if out else f"(no output, rc={rc})")
        if rc == 3 and k == 0:
            print(out); print("DUPLICATE? Ask before re-running with: nut log ... --force"); sys.exit(3)
        rc_all = rc_all or rc
    rc, out = run(["summary", "--person", person]); print("—\n" + out)
    sys.exit(rc_all)
elif cmd == "today":
    who = args[0] if args else "all"
    if who == "all":
        rc, out = run(["people-day"]); print(out)
        for line in out.splitlines():
            p = line.split()[0] if line.split() else ""
            if re.fullmatch(r"[a-z]+", p):
                print("—"); print(run(["summary", "--person", p])[1])
    else:
        print(run(["summary", "--person", who])[1])
elif cmd == "find":
    print(run(["food", "find", " ".join(args)])[1])
elif cmd == "fix":
    rc, out = run(["edit"] + args); print(out); sys.exit(rc)
else:
    rc, out = run([cmd] + args); print(out); sys.exit(rc)
